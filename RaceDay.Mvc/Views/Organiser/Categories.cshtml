@model (int EventId, IReadOnlyList<RaceDay.Contracts.CategoryDto> Categories)
@{ var ev = (RaceDay.Contracts.EventDto)ViewBag.Event; ViewData["Title"] = "Event categories"; }
<a asp-action="Events" class="back-link">← My events</a><section class="page-heading compact"><span class="eyebrow">@ev.Name</span><h1>Event <em>categories.</em></h1><p>Set age groups and distances that work for your field.</p></section>
<div class="editor-card"><h2>Add a category</h2><form asp-action="SaveCategory" method="post" class="form-grid"><input type="hidden" name="EventId" value="@Model.EventId"/><div><label>Category name</label><input name="Name" required class="form-control" placeholder="e.g. Senior, Under 20"/></div><div><label>Distance (km, optional)</label><input name="DistanceKm" type="number" min=".01" step=".01" class="form-control" placeholder="Event distance"/></div><div><label>Maximum participants</label><input name="MaxParticipants" type="number" min="1" value="100" class="form-control"/></div><div><label>Entry fee (R)</label><input name="EntryFee" type="number" min="0" step="0.01" value="0" class="form-control"/></div><button class="btn-race">Add category <span>→</span></button></form></div>
<div class="category-grid">@foreach (var c in Model.Categories) { <article class="category-card"><form asp-action="UpdateCategory" method="post" class="category-edit"><input type="hidden" name="CategoryId" value="@c.CategoryId"/><input type="hidden" name="EventId" value="@Model.EventId"/><div><label class="eyebrow">CATEGORY</label><input name="Name" value="@c.Name" required class="form-control"/><small>@c.DistanceKm km</small></div><div><label>Capacity</label><input name="MaxParticipants" value="@c.MaxParticipants" type="number" min="1" class="form-control"/></div><div><label>Fee (R)</label><input name="EntryFee" value="@c.EntryFee" type="number" min="0" step=".01" class="form-control"/></div><button class="btn-race small">Save</button></form><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@Model.EventId"/><button class="link-danger">Delete</button></form></article> }</div>
