@model RaceDay.Mvc.ViewModels.EventFormVm
@{ ViewData["Title"] = "Manage events"; }
<section class="page-heading compact"><span class="eyebrow">YOUR RACE CALENDAR</span><h1>Event <em>management.</em></h1><p>Create the moments runners will remember.</p></section><div class="editor-card"><h2>@(Model.EventId == 0 ? "Create an event" : "Update event")</h2><form asp-action="SaveEvent" method="post" class="form-grid"><div asp-validation-summary="ModelOnly" class="text-danger wide"></div><input asp-for="EventId" type="hidden"/><div><label asp-for="Name">Event name</label><input asp-for="Name" class="form-control"/></div><div><label asp-for="EventType">Event type</label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div><label asp-for="Date">Date and time</label><input asp-for="Date" class="form-control" type="datetime-local"/></div><div><label asp-for="Location">Location</label><input asp-for="Location" class="form-control"/></div><div><label asp-for="DistanceKm">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/></div><div class="wide"><label asp-for="Description">Description</label><textarea asp-for="Description" class="form-control"></textarea></div><button class="btn-race">@(Model.EventId == 0 ? "Create event" : "Save changes") <span>→</span></button></form></div><div class="section-line"><h2>All your events</h2><span>@Model.Events.Count events</span></div><div class="table-wrap"><table class="table"><thead><tr><th>EVENT</th><th>DATE</th><th>LOCATION</th><th>DISTANCE</th><th>ACTIONS</th></tr></thead><tbody>@foreach (var ev in Model.Events) { <tr><td><strong>@ev.Name</strong><small>@ev.EventType</small></td><td>@RaceDayClock.ToSouthAfricanTime(ev.Date).ToString("dd MMM yyyy")</td><td>@ev.Location</td><td>@ev.DistanceKm km</td><td><a asp-action="Events" asp-route-editId="@ev.EventId">Edit</a> · <a asp-action="Categories" asp-route-id="@ev.EventId">Categories</a> · <a asp-action="Enrolments" asp-route-id="@ev.EventId">Entries/results</a><form asp-action="DeleteEvent" method="post" class="inline"><input type="hidden" name="id" value="@ev.EventId"/><button class="link-danger" onclick="return confirm('Delete this event?')">Delete</button></form><form asp-action="UploadBanner" method="post" enctype="multipart/form-data" class="inline"><input type="hidden" name="id" value="@ev.EventId"/><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required/><button class="link-danger">Banner</button></form></td></tr> }</tbody></table></div>
