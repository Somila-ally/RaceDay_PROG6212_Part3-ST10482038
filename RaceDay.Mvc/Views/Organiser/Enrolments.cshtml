@model RaceDay.Mvc.ViewModels.EnrolmentPageVm
@{ ViewData["Title"] = "Entries and results"; }
<a asp-action="Events" class="back-link">← My events</a><section class="page-heading compact"><span class="eyebrow">EVENT OPERATIONS</span><h1>@Model.EventName <em>entries.</em></h1><p>See who's on the start list and record finish results after race day.</p></section><div class="table-wrap"><table class="table"><thead><tr><th>PARTICIPANT</th><th>CATEGORY</th><th>STATUS</th><th>RESULT ENTRY</th></tr></thead><tbody>@foreach (var row in Model.Enrolments) { <tr><td><strong>@row.ParticipantName</strong></td><td>@row.CategoryName</td><td><form asp-action="UpdateEnrolmentStatus" method="post" class="inline"><input type="hidden" name="id" value="@row.EnrolmentId"/><input type="hidden" name="eventId" value="@Model.EventId"/><select name="status" class="form-select status-select"><option selected="@(row.Status == "Registered")">Registered</option><option selected="@(row.Status == "Pending")">Pending</option><option selected="@(row.Status == "Confirmed")">Confirmed</option><option selected="@(row.Status == "Cancelled")">Cancelled</option></select><button class="text-link">Save</button></form></td><td><form asp-action="SaveResult" method="post" class="result-form"><input type="hidden" name="EventId" value="@Model.EventId"/><input type="hidden" name="EnrolmentId" value="@row.EnrolmentId"/><input name="FinishTime" class="form-control" placeholder="hh:mm:ss" required/><input name="FinishPosition" type="number" min="1" class="form-control position" placeholder="Place" required/><button class="btn-race small">Record</button></form></td></tr> }</tbody></table></div>
