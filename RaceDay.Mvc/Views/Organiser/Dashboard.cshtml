@model IReadOnlyList<RaceDay.Contracts.EventDto>
@{ ViewData["Title"] = "Organiser dashboard"; }
<section class="page-heading compact"><span class="eyebrow">ORGANISER STUDIO</span><h1>Good things <em>start here.</em></h1><p>Your events, all in one place. Build a day people remember.</p></section><div class="stats-row"><div><span>YOUR EVENTS</span><strong>@Model.Count</strong></div><div><span>UPCOMING RACES</span><strong>@Model.Count(e => e.Date >= DateTime.Today)</strong></div><a class="btn-race" asp-action="Events">Manage events <span>→</span></a></div><div class="section-line"><h2>Your next start lines</h2><a class="text-link" asp-action="Events">Manage all →</a></div><div class="event-grid">@foreach (var ev in Model.OrderBy(e => e.Date).Take(3)) { <article class="event-card"><div class="event-icon">↗<span>@ev.EventType</span></div><h2>@ev.Name</h2><p>@ev.Description</p><div class="event-meta"><span>◷ @RaceDayClock.ToSouthAfricanTime(ev.Date).ToString("dd MMM yyyy")</span><span>⌖ @ev.Location</span></div><div class="event-bottom"><strong>@ev.DistanceKm km</strong><a class="text-link" asp-action="Enrolments" asp-route-id="@ev.EventId">Enrolments →</a></div></article> }</div>
