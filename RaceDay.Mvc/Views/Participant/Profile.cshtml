@model RaceDay.Mvc.ViewModels.ProfileVm
@{ ViewData["Title"] = "My profile"; }
<section class="page-heading compact"><span class="eyebrow">YOUR RACEDAY ACCOUNT</span><h1>My <em>profile.</em></h1><p>Keep your personal details up to date.</p></section><div class="editor-card profile-card">@if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)) { <img src="@Model.ProfileImageUrl" alt="Profile image" class="profile-image"/> }<form asp-action="Profile" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control"/><span asp-validation-for="FirstName" class="text-danger"></span><label asp-for="LastName"></label><input asp-for="LastName" class="form-control"/><span asp-validation-for="LastName" class="text-danger"></span><label>Email</label><input value="@Model.Email" class="form-control" disabled/><label>Role</label><input value="@Model.Role" class="form-control" disabled/><label>Profile image (JPG, PNG or WebP, up to 5 MB)</label><input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="form-control"/><button class="btn-race mt-4">Save changes <span>→</span></button></form></div>
