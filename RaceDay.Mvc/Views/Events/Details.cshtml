@model RaceDay.Mvc.ViewModels.EventPageVm
@{ ViewData["Title"] = Model.Event.Name; }
<a asp-action="Index" class="back-link">← All events</a><section class="detail-hero" style="@(Model.Event.BannerImageUrl is null ? "" : $"background-image:linear-gradient(90deg,#e7f3e9e8,#f1f5dce8),url({Model.Event.BannerImageUrl});background-size:cover;background-position:center")"><div><span class="eyebrow">@Model.Event.EventType · @Model.Event.DistanceKm KM</span><h1>@Model.Event.Name</h1><p>@Model.Event.Description</p></div><div class="detail-date"><span>@RaceDayClock.ToSouthAfricanTime(Model.Event.Date).ToString("MMM")</span><strong>@RaceDayClock.ToSouthAfricanTime(Model.Event.Date).ToString("dd")</strong><span>@RaceDayClock.ToSouthAfricanTime(Model.Event.Date).ToString("yyyy")</span></div></section><div class="detail-facts"><span>⌖ <strong>@Model.Event.Location</strong></span><span>◷ <strong>@RaceDayClock.ToSouthAfricanTime(Model.Event.Date).ToString("dddd, dd MMMM yyyy · HH:mm")</strong></span><span>HOSTED BY <strong>@Model.Event.OrganiserName</strong></span></div><div class="section-line"><h2>Choose your category</h2><span>MAKE IT YOUR RACE</span></div><div class="category-grid">@foreach (var c in Model.Categories) { <article class="category-card"><div><span class="eyebrow">ENTRY CATEGORY</span><h3>@c.Name</h3><p>@c.DistanceKm km · up to @c.MaxParticipants participants</p></div><div class="category-action"><strong>@(c.EntryFee == 0 ? "FREE" : $"R{c.EntryFee:N2}")</strong>@if (Context.Session.GetString("Role") == "Participant") { <form asp-action="Enrol" method="post"><input type="hidden" name="eventId" value="@Model.Event.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn-race">Enter <span>→</span></button></form> } else { <a asp-controller="Auth" asp-action="Login" class="text-link">Sign in to enter →</a> }</div></article> }</div>
