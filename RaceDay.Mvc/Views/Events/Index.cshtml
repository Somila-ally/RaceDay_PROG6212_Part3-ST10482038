@model RaceDay.Mvc.ViewModels.EventSearchVm
@{ ViewData["Title"] = "Find your next event"; }
<section class="page-heading"><span class="eyebrow">THE START LINE IS YOURS</span><h1>Find your next <em>event.</em></h1><p>Good races are made of good people. Find one that moves you.</p></section>
<form method="get" class="event-filter"><input name="query" value="@Model.Query" class="form-control" placeholder="Search event or location" aria-label="Search event or location"/><select name="eventType" class="form-select" aria-label="Filter by event type"><option value="All">All event types</option><option value="Run" selected="@(Model.EventType == "Run" ? "selected" : null)">Run</option><option value="Walk" selected="@(Model.EventType == "Walk" ? "selected" : null)">Walk</option><option value="Cycle" selected="@(Model.EventType == "Cycle" ? "selected" : null)">Cycle</option></select><select name="upcomingOnly" class="form-select" aria-label="Filter by date"><option value="true" selected="@(Model.UpcomingOnly ? "selected" : null)">Upcoming only</option><option value="false" selected="@(!Model.UpcomingOnly ? "selected" : null)">Any date</option></select><button class="btn-race">Search <span>→</span></button></form>
<div class="section-line"><span>@Model.Events.Count events</span><span>RUN · WALK · CYCLE</span></div><div class="event-grid">
@foreach (var ev in Model.Events) { <article class="event-card">@if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl)) { <img class="event-banner" src="@ev.BannerImageUrl" alt="Banner for @ev.Name"/> } else { <div class="event-icon">↗<span>@ev.EventType</span></div> }<h2>@ev.Name</h2><p>@ev.Description</p><div class="event-meta"><span>◷ @RaceDayClock.ToSouthAfricanTime(ev.Date).ToString("dd MMM yyyy")</span><span>⌖ @ev.Location</span></div><div class="event-bottom"><span><strong>@ev.DistanceKm km</strong> distance</span><a class="text-link" asp-action="Details" asp-route-id="@ev.EventId">View event <b>→</b></a></div></article> }
</div>
