@{ var role = Context.Session.GetString("Role"); var name = Context.Session.GetString("Name") ?? "Runner"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · RaceDay</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="topbar"><nav class="navbar navbar-expand-lg container"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RACE<span>DAY</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">☰</button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
@if (role == "Organiser") { <li><a asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li><li><a asp-controller="Organiser" asp-action="Events">My events</a></li><li><a asp-controller="Participant" asp-action="Profile">Profile</a></li> }
@if (role == "Participant") { <li><a asp-controller="Events" asp-action="Index">Find events</a></li><li><a asp-controller="Participant" asp-action="MyEvents">My entries</a></li><li><a asp-controller="Participant" asp-action="MyResults">My results</a></li><li><a asp-controller="Participant" asp-action="Profile">Profile</a></li> }
@if (role is null) { <li><a asp-controller="Auth" asp-action="Login">Sign in</a></li><li><a class="nav-cta" asp-controller="Auth" asp-action="Register">Join RaceDay</a></li> }
@if (role is not null) { <li class="welcome">Hi, @name</li><li><form asp-controller="Auth" asp-action="Logout" method="post"><button class="nav-logout">Sign out</button></form></li> }
</ul></div></nav></header><main class="container page-wrap">
@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> } @RenderBody()
</main><footer class="container footer"><span>RACEDAY · Find your pace.</span><span>Events for every finish line.</span></footer><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script><script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
