@model RaceDay.Mvc.Models.ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<section class="page-heading compact"><span class="eyebrow">RACEDAY</span><h1>We hit a <em>stumble.</em></h1><p>Something went wrong while loading this page. Please try again.</p>@if (Model.ShowRequestId) { <p class="muted">Reference: <code>@Model.RequestId</code></p> }<a class="btn-race" asp-controller="Home" asp-action="Index">Back to RaceDay <span>→</span></a></section>
